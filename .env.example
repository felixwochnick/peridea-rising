# Sessions (nuxt-auth-utils), at least 32 characters – generated automatically in development
NUXT_SESSION_PASSWORD=

# Authentik (OAuth2/OpenID provider, redirect URI: <app>/auth/authentik)
NUXT_OAUTH_AUTHENTIK_CLIENT_ID=
NUXT_OAUTH_AUTHENTIK_CLIENT_SECRET=
# without https://
NUXT_OAUTH_AUTHENTIK_DOMAIN=auth.example.com

# Multiplayer – HMAC key (HS256) of the player tokens, signed by the app, verified by the Colyseus server
NUXT_MULTIPLAYER_SECRET=
# Empty: production serves the multiplayer under <app>/colyseus, development uses `pnpm dev:mp` (ws://localhost:2567).
# Only needed for a separately hosted multiplayer server.
NUXT_PUBLIC_MULTIPLAYER_URL=
# PORT=3000
# MULTIPLAYER_DICE=local   # offline: local dice instead of drand

# PostgreSQL – the schema is created / migrated automatically on startup
POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
POSTGRES_USER=peridea
POSTGRES_PASSWORD=
POSTGRES_DB=peridea
