{
  "name": "peridea-rising",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "dev:mp": "tsx watch --env-file-if-exists=.env multiplayer/server.ts",
    "start:mp": "tsx --env-file-if-exists=.env multiplayer/server.ts",
    "build:mp": "esbuild multiplayer/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/multiplayer/server.mjs --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\""
  },
  "dependencies": {
    "@colyseus/core": "^0.18.23",
    "@colyseus/sdk": "^0.18.6",
    "@colyseus/ws-transport": "^0.18.4",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/lucide": "^1.2.127",
    "@iconify-json/simple-icons": "^1.2.94",
    "@nuxt/content": "3.16.0",
    "@nuxt/ui": "^4.11.0",
    "@tresjs/cientos": "^5.8.1",
    "@tresjs/nuxt": "5.6.3",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.13",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.32",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^0.14.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.5",
    "@types/three": "~0.184.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.24.0"
}
